# OpenAI API Key for generation and critic passes
OPENAI_API_KEY=your_openai_api_key_here

# Qdrant Vector DB Settings
QDRANT_URL= # Use for Qdrant Cloud (e.g., https://xxxx.aws.cloud.qdrant.io). Overrides QDRANT_HOST/PORT if set.
QDRANT_HOST=localhost # Use for local self-hosted Qdrant docker
QDRANT_PORT=6333
QDRANT_API_KEY= # Leave empty for local docker; paste cloud API key for Qdrant Cloud

# Simple API Key Security
APP_API_KEY=secure-admin-token-change-me

# Rate Limiting
RATE_LIMIT_RPM=60

# Model Settings
LLM_MODEL=gpt-4o-mini
DENSE_EMBEDDING_MODEL=all-MiniLM-L6-v2
SPARSE_EMBEDDING_MODEL=Qdrant/bm25

# RAG Configuration
CHUNK_SIZE=512
CHUNK_OVERLAP=50
RELEVANCE_THRESHOLD=0.35
